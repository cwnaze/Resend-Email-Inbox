# Turso (libSQL) database — see https://docs.turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudflare R2 (S3-compatible) attachment storage — bucket is private, no
# public URL/custom domain; downloads use presigned URLs generated on demand.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Resend (outbound email) — used to send the one-button login code and
# outbound mail. AUTH_RECIPIENT_EMAIL is the single hardcoded recipient of
# login-code emails; it is never read from request input.
RESEND_API_KEY=
AUTH_RECIPIENT_EMAIL=

# Resend inbound webhook — Svix signing secret from the Resend dashboard
# webhook config (starts with `whsec_`). Used to verify every request to
# POST /api/webhooks/resend-inbound before its body is parsed.
RESEND_INBOUND_WEBHOOK_SECRET=

# Public contact form (POST /api/contact) — comma-separated origin allowlist for
# the static caseynazelrod.com site that posts to it. Optional; defaults to the
# production + www domains plus localhost dev ports.
CONTACT_ALLOWED_ORIGINS=https://caseynazelrod.com,https://www.caseynazelrod.com
